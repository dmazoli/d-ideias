{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.module.ts",
    "!src/main.ts",
    "!src/**/*.schema.ts",
    "!src/**/*.spec.ts",
    "!src/infrastructure/migrations/**"
  ],
  "coverageDirectory": "coverage/e2e",
  "coveragePathIgnorePatterns": [
    "/node_modules/"
  ]
}